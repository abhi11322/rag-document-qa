# Copy this file to .env and fill in your own values. Never commit .env.

# LLM provider used for answer generation
LLM_PROVIDER=gemini

# Model name for the selected provider
LLM_MODEL=gemini-2.5-flash

# API key for the LLM provider (get one at https://aistudio.google.com/apikey for Gemini)
LLM_API_KEY=

# Path to the source PDF used as the knowledge base
PDF_PATH=data/Document.pdf

# Local Hugging Face / Sentence Transformers embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Directory where the persisted Chroma vector database is stored/loaded
CHROMA_PERSIST_DIR=data/chroma
